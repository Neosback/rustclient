+		}
+
+		McpConfig.setPort(result.getPort());
+		McpConfig.setAutoStart(result.isAutoStart());
+		McpConfig.setBindAll(result.isBindAll());
+		McpConfig.save();
+	}
+
 	private void onGithubClicked() {
 		GuiUtil.openUrl("https://github.com/FabricMC/Enigma");
 	}
