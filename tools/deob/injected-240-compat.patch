+package net.runelite.asm;
+
+import java.util.IdentityHashMap;
+import java.util.Map;
+import org.objectweb.asm.ConstantDynamic;
+import org.objectweb.asm.Handle;
+import org.objectweb.asm.Opcodes;
+
+/** Scratch compatibility adapter: keep bootstrap handles attached to renamed members. */
+public final class DynamicReferences {
+    private final Map<Handle, Method> methods = new IdentityHashMap<>();
+    private final Map<Handle, Field> fields = new IdentityHashMap<>();
+
+    public void lookup(Object value, ClassGroup group) {
+        if (value instanceof ConstantDynamic) {
+            ConstantDynamic c = (ConstantDynamic) value;
+            lookup(c.getBootstrapMethod(), group);
+            for (int i = 0; i < c.getBootstrapMethodArgumentCount(); i++) lookup(c.getBootstrapMethodArgument(i), group);
+        } else if (value instanceof Handle) {
+            Handle h = (Handle) value;
+            ClassFile owner = group.findClass(h.getOwner());
+            if (owner == null) return;
+            if (h.getTag() <= Opcodes.H_PUTSTATIC) {
+                Field f = owner.findField(h.getName(), new Type(h.getDesc()));
+                if (f != null) fields.put(h, f);
+            } else {
+                Method m = owner.findMethod(h.getName(), new net.runelite.asm.signature.Signature(h.getDesc()));
+                if (m != null) methods.put(h, m);
+            }
+        }
+    }
+
+    public Object rewrite(Object value, String oldName, String newName) {
+        if (value instanceof ConstantDynamic) {
+            ConstantDynamic c = (ConstantDynamic) value;
+            Object[] args = new Object[c.getBootstrapMethodArgumentCount()];
+            for (int i = 0; i < args.length; i++) args[i] = rewrite(c.getBootstrapMethodArgument(i), oldName, newName);
+            return new ConstantDynamic(c.getName(), descriptor(c.getDescriptor(), oldName, newName),
+                (Handle) rewrite(c.getBootstrapMethod(), oldName, newName), args);
+        }
+        if (value instanceof org.objectweb.asm.Type) {
+            return org.objectweb.asm.Type.getType(descriptor(((org.objectweb.asm.Type) value).getDescriptor(), oldName, newName));
+        }
+        if (!(value instanceof Handle)) return value;
+        Handle h = (Handle) value;
+        String owner = h.getOwner(), name = h.getName(), desc = h.getDesc();
+        Method m = methods.get(h);
+        Field f = fields.get(h);
+        if (oldName == null) {
+            if (m != null) { owner = m.getClassFile().getName(); name = m.getName(); desc = m.getDescriptor().toString(); }
+            if (f != null) { owner = f.getClassFile().getName(); name = f.getName(); desc = f.getType().toString(); }
+        } else {
+            if (owner.equals(oldName)) owner = newName;
+            desc = descriptor(desc, oldName, newName);
+        }
+        Handle out = new Handle(h.getTag(), owner, name, desc, h.isInterface());
+        if (m != null) methods.put(out, m);
+        if (f != null) fields.put(out, f);
+        return out;
+    }
+
+    public static String descriptor(String value, String oldName, String newName) {
+        return oldName == null ? value : value.replace("L" + oldName + ";", "L" + newName + ";");
+    }
+}
